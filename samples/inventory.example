# Static Ansible inventory for the on-prem cluster.
# Copy to /etc/ansible/hosts on the controller and edit hosts/vars for your site.
#
# Each compute host must set node_profile to a key from the node_profiles map
# in playbooks/group_vars/all.yml (this selects GPU type/count, gres layout,
# Slurm features, and whether nvidia-fabricmanager is required).

[controller]
sv5 ansible_host=10.0.0.10 ansible_user=ubuntu role=controller ansible_python_interpreter=/usr/bin/python3

[slurm_backup]

[login]

[monitoring]

[compute_to_add]

[compute_configured]
hgxa100 ansible_host=10.0.0.21 ansible_user=ubuntu role=compute node_profile=a100-hgx8
lucid ansible_host=10.0.0.22 ansible_user=exx role=compute node_profile=h100nvl-1

[compute_to_destroy]

[nfs]

[compute:children]
compute_to_add
compute_configured

# --- ceph (separate phase: playbooks/ceph.yml; never touched by site.yml) ---
# Interim single-node deployment on the HGX A100; swaps to the dedicated
# storage nodes later by repointing these groups (failure domain osd -> host,
# ceph_single_host -> false).
[ceph]
hgxa100 ansible_host=10.0.0.21 ansible_user=ubuntu

[ceph_bootstrap]
hgxa100

[ceph:vars]
ceph_public_network=10.0.0.0/24
ceph_cluster_network=
ceph_single_host=true
# Model string of the DATA drives only. Selecting by /dev path is unsafe —
# NVMe enumeration shifted between reboots on this exact host. The OS drives
# (model MZ1L21T9HCLS) must never match this.
ceph_data_device_model=MZQL23T8HCLS
ceph_osds_per_host=8
ceph_total_osds=8
# Single host: failure domain must be osd, or PGs never go active.
ceph_ec_failure_domain=osd
ceph_ec_k=4
ceph_ec_m=2
ceph_ec_profile=ec42
ceph_mds_count=1
ceph_deploy_rgw=False
ceph_rgw_name=s3
ceph_rgw_count=1
ceph_rgw_port=8000
ceph_deploy_monitoring=False
ceph_mclock_profile=balanced

[all:vars]
ansible_connection=ssh
cluster_name=cerberus
queue=cerberus
instance_type=cerberus
shape=onprem
cluster_network=False
slurm=true
spack=False
ldap=true
enroot=true
pyxis=true
pam=False  # hardening: enable only after the cluster is verified (pam_slurm_adopt blocks SSH for users without jobs)
sacct_limits=False
healthchecks=true  # GPU health prolog + 300s idle check; drains the node on ECC/XID/remap/bus/GPU-count failure
cluster_monitoring=true
autoscaling=False
autoscaling_monitoring=False
monitoring_mysql_ip=localhost
rack_aware=False
latency_check=False
change_hostname=False
hostname_convention=
hyperthreading=true
# DANGER if true: the localdisk role RAIDs every unformatted data NVMe at
# configure time — on a host whose data drives belong to Ceph (see [ceph]
# below) that destroys the OSD device plan. Leave False when any compute
# host doubles as a Ceph host.
localdisk=False
redundancy=False
log_vol=False
nvme_path=/mnt/localdisk/
# --- storage ---
# home_backend selects where /clusterhome (shared LDAP-user homes) lives:
#   nfs    — controller exports it over NFS (greenfield bootstrap default;
#            works before Ceph exists)
#   cephfs — mounted from the Ceph cluster (deploy playbooks/ceph.yml first)
home_backend=nfs
# consumed by the cephfs-client role on every node (hence all:vars, not
# ceph:vars): the mon address and filesystem name of the Ceph cluster
ceph_mon_ip=10.0.0.21
ceph_fs_name=lucidfs
home_nfs=true
cluster_nfs=true
cluster_nfs_path=/nfs/cluster
slurm_nfs_path=/nfs/cluster
scratch_nfs=False
scratch_nfs_path=/nfs/scratch
scratch_nfs_type=nfs
add_nfs=False
nfs_target_path=/nfs/scratch
nfs_source_IP=
nfs_source_path=
nfs_options=
create_fss=False
# --- users ---
compute_username=ubuntu
controller_username=ubuntu
privilege_sudo=true
privilege_group_name=privilege
admin_username=admin
admin_password=CHANGE_ME
